    <string name="app_name">Dice la Escritura</string>

    <!-- Bienvenida -->
    <string name="onboarding_titulo">Bienvenido a Dice la Escritura</string>
    <string name="onboarding_intro">Aprende la Biblia un poco cada día, sin conexión a internet. Todo se basa en la Reina-Valera 1960 y tu progreso se guarda solo en este teléfono.</string>
    <string name="onboarding_perfil_titulo">¿Cómo te llamas?</string>
    <string name="onboarding_perfil_descripcion">Es solo un nombre y un color para esta app; no hay cuenta ni registro y no sale de tu teléfono. Si prefieres no ponerlo, usaremos «Estudiante».</string>
    <string name="onboarding_confesion_titulo">Módulo opcional: Confesión Bautista de Fe de 1689</string>
    <string name="onboarding_confesion_descripcion">Además del contenido bíblico base, la app incluye un módulo aparte con preguntas sobre la Confesión Bautista de Fe de 1689, un documento histórico de la tradición bautista reformada. Es un contenido distinto del bíblico: las preguntas del módulo base solo se apoyan en lo que el texto bíblico afirma directamente.</string>
    <string name="onboarding_confesion_cambiar">Puedes activarlo o desactivarlo cuando quieras en Ajustes. Mientras esté desactivado, no aparece en ninguna parte de la app.</string>
    <string name="onboarding_activar">Activar el módulo</string>
    <string name="onboarding_ahora_no">Ahora no</string>

