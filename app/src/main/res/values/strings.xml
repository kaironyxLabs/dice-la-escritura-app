    <!-- Acerca de -->
    <string name="ajustes_acerca_titulo">Acerca de</string>
    <string name="ajustes_acerca_version">Dice la Escritura, versión %1$s</string>
    <string name="ajustes_acerca_descripcion">App para aprender la Biblia un poco cada día, sin conexión. Sin anuncios, sin analíticas y sin cuentas: tus datos viven solo en este teléfono. El texto bíblico es la Reina-Valera 1960 y lo aporta cada usuario. Tipografías Inter y Source Serif 4 bajo licencia SIL Open Font 1.1.</string>

